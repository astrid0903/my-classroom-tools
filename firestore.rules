rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isShortId(value) {
      return value is string && value.size() > 0 && value.size() <= 120;
    }

    function isOptionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function isPostImageAt(images, index) {
      return images.size() <= index
        || (images[index] is string && images[index].size() <= 180000);
    }

    function isPostImages(value) {
      return value is list
        && value.size() <= 5
        && isPostImageAt(value, 0)
        && isPostImageAt(value, 1)
        && isPostImageAt(value, 2)
        && isPostImageAt(value, 3)
        && isPostImageAt(value, 4);
    }

    function isOptionalPostImages(value) {
      return value == null || isPostImages(value);
    }

    function isOptionalPostOrder(value) {
      return value == null || (value is number && value >= -9999999999999 && value <= 9999999999999);
    }

    function isParticipantMode(value) {
      return value == "edit" || value == "add" || value == "view";
    }

    function isOptionalPollOptions(value) {
      return value == null || (value is list && value.size() <= 10);
    }

    function isOptionalPollVotes(value) {
      return value == null || value is map;
    }

    function isOptionalBoolean(value) {
      return value == null || value is bool;
    }

    function hasPostBody() {
      return (request.resource.data.get('content', null) is string && request.resource.data.get('content', '').size() > 0)
        || (request.resource.data.get('imageDataUrl', null) is string && request.resource.data.get('imageDataUrl', '').size() > 0)
        || (request.resource.data.get('imageDataUrls', null) is list && request.resource.data.get('imageDataUrls', []).size() > 0)
        || (request.resource.data.get('pollOptions', null) is list && request.resource.data.get('pollOptions', []).size() > 0);
    }

    function isPostBoardMetadata() {
      return request.auth != null
        && request.resource.data.keys().hasOnly(['title', 'adminUid', 'sections', 'note', 'participantMode', 'bgColor', 'bgImage', 'bgOpacity', 'titleColor', 'updatedAt', 'kind', 'version'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.sections is list
        && request.resource.data.sections.size() <= 12
        && isOptionalString(request.resource.data.get('note', null), 5000)
        && isParticipantMode(request.resource.data.participantMode)
        && isOptionalString(request.resource.data.get('bgColor', null), 40)
        && isOptionalString(request.resource.data.get('bgImage', null), 900000)
        && request.resource.data.bgOpacity is number
        && request.resource.data.bgOpacity >= 0
        && request.resource.data.bgOpacity <= 100
        && isOptionalString(request.resource.data.get('titleColor', null), 40)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.kind == 'postBoard'
        && request.resource.data.version == 1;
    }

    function isPostBoardAdminMetadata() {
      return request.auth != null
        && request.resource.data.keys().hasOnly(['adminUid', 'adminKey', 'updatedAt', 'kind', 'version'])
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.adminKey is string
        && request.resource.data.adminKey.size() >= 24
        && request.resource.data.adminKey.size() <= 120
        && request.resource.data.updatedAt == request.time
        && request.resource.data.kind == 'postBoardAdmin'
        && request.resource.data.version == 1;
    }

    function isPost() {
      return request.resource.data.keys().hasOnly(['author', 'sectionId', 'content', 'imageDataUrl', 'imageDataUrls', 'order', 'createdAt', 'authorUid', 'type', 'pollOptions', 'pollVotes', 'isStarred'])
        && isOptionalString(request.resource.data.get('author', null), 40)
        && request.resource.data.sectionId is string
        && request.resource.data.sectionId.size() > 0
        && request.resource.data.sectionId.size() <= 80
        && isOptionalString(request.resource.data.get('content', null), 600)
        && isOptionalString(request.resource.data.get('imageDataUrl', null), 950000)
        && isOptionalPostImages(request.resource.data.get('imageDataUrls', null))
        && isOptionalPostOrder(request.resource.data.get('order', null))
        && isOptionalString(request.resource.data.get('type', null), 20)
        && isOptionalPollOptions(request.resource.data.get('pollOptions', null))
        && isOptionalPollVotes(request.resource.data.get('pollVotes', null))
        && isOptionalBoolean(request.resource.data.get('isStarred', null))
        && request.resource.data.createdAt == request.time
        && request.resource.data.authorUid == request.auth.uid
        && hasPostBody();
    }

    function isPostEdit() {
      return request.resource.data.keys().hasOnly(['author', 'sectionId', 'content', 'imageDataUrl', 'imageDataUrls', 'order', 'createdAt', 'updatedAt', 'authorUid', 'type', 'pollOptions', 'pollVotes', 'isStarred'])
        && isOptionalString(request.resource.data.get('author', null), 40)
        && request.resource.data.sectionId is string
        && request.resource.data.sectionId.size() > 0
        && request.resource.data.sectionId.size() <= 80
        && isOptionalString(request.resource.data.get('content', null), 600)
        && isOptionalString(request.resource.data.get('imageDataUrl', null), 950000)
        && isOptionalPostImages(request.resource.data.get('imageDataUrls', null))
        && isOptionalPostOrder(request.resource.data.get('order', null))
        && isOptionalString(request.resource.data.get('type', null), 20)
        && isOptionalPollOptions(request.resource.data.get('pollOptions', null))
        && isOptionalPollVotes(request.resource.data.get('pollVotes', null))
        && isOptionalBoolean(request.resource.data.get('isStarred', null))
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.updatedAt == request.time
        && hasPostBody();
    }

    function isAdminPostEdit() {
      return request.auth != null
        && request.resource.data.keys().hasOnly(['author', 'sectionId', 'content', 'imageDataUrl', 'imageDataUrls', 'order', 'createdAt', 'updatedAt', 'authorUid', 'type', 'pollOptions', 'pollVotes', 'isStarred'])
        && isOptionalString(request.resource.data.get('author', null), 40)
        && request.resource.data.sectionId is string
        && request.resource.data.sectionId.size() > 0
        && request.resource.data.sectionId.size() <= 80
        && isOptionalString(request.resource.data.get('content', null), 600)
        && isOptionalString(request.resource.data.get('imageDataUrl', null), 950000)
        && isOptionalPostImages(request.resource.data.get('imageDataUrls', null))
        && isOptionalPostOrder(request.resource.data.get('order', null))
        && isOptionalString(request.resource.data.get('type', null), 20)
        && isOptionalPollOptions(request.resource.data.get('pollOptions', null))
        && isOptionalPollVotes(request.resource.data.get('pollVotes', null))
        && isOptionalBoolean(request.resource.data.get('isStarred', null))
        && request.resource.data.updatedAt == request.time
        && hasPostBody();
    }

    function isPollVoteOnlyUpdate() {
      return request.resource.data.keys().hasOnly(['author', 'sectionId', 'content', 'imageDataUrl', 'imageDataUrls', 'order', 'createdAt', 'updatedAt', 'authorUid', 'type', 'pollOptions', 'pollVotes', 'isStarred'])
        && request.resource.data.get('author', null) == resource.data.get('author', null)
        && request.resource.data.sectionId == resource.data.sectionId
        && request.resource.data.get('content', null) == resource.data.get('content', null)
        && request.resource.data.get('imageDataUrl', null) == resource.data.get('imageDataUrl', null)
        && request.resource.data.get('imageDataUrls', null) == resource.data.get('imageDataUrls', null)
        && request.resource.data.get('order', null) == resource.data.get('order', null)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.get('type', null) == resource.data.get('type', null)
        && request.resource.data.get('pollOptions', null) == resource.data.get('pollOptions', null)
        && request.resource.data.get('isStarred', null) == resource.data.get('isStarred', null)
        && isOptionalPollVotes(request.resource.data.get('pollVotes', null))
        && request.resource.data.updatedAt == request.time;
    }

    function isOwnPostEdit() {
      return request.auth != null
        && resource.data.authorUid == request.auth.uid
        && isPostEdit();
    }

    function isOwnPost() {
      return request.auth != null
        && resource.data.authorUid == request.auth.uid;
    }

    function isBoardAdmin(boardId) {
      return request.auth != null
        && (
          get(/databases/$(database)/documents/classroomPostBoards/$(boardId)).data.adminUid == request.auth.uid
          || get(/databases/$(database)/documents/classroomPostBoardAdmins/$(boardId)).data.adminUid == request.auth.uid
        );
    }

    function boardParticipantMode(boardId) {
      return get(/databases/$(database)/documents/classroomPostBoards/$(boardId)).data.participantMode;
    }

    function participantCanCreate(boardId) {
      return request.auth != null
        && (!get(/databases/$(database)/documents/classroomPostBoards/$(boardId)).data.keys().hasAny(['participantMode'])
          || boardParticipantMode(boardId) == "edit"
          || boardParticipantMode(boardId) == "add");
    }

    function participantCanEdit(boardId) {
      return request.auth != null
        && (!get(/databases/$(database)/documents/classroomPostBoards/$(boardId)).data.keys().hasAny(['participantMode'])
          || boardParticipantMode(boardId) == "edit");
    }

    match /classroomToolLayouts/{syncCode} {
      allow read: if isShortId(syncCode);
      allow write: if isShortId(syncCode)
        && request.resource.data.keys().hasOnly(['layouts', 'updatedAt', 'version'])
        && request.resource.data.layouts is map
        && request.resource.data.updatedAt == request.time
        && request.resource.data.version == 1;
    }

    match /classroomPostBoards/{boardId} {
      allow read: if isShortId(boardId);
      allow create: if isShortId(boardId) && isPostBoardMetadata();
      allow update: if isShortId(boardId)
        && isPostBoardMetadata()
        && (
          !resource.data.keys().hasAny(['adminUid'])
          || resource.data.adminUid == ""
          || resource.data.adminUid == request.auth.uid
          || get(/databases/$(database)/documents/classroomPostBoardAdmins/$(boardId)).data.adminUid == request.auth.uid
        );
      allow delete: if false;

      match /posts/{postId} {
        allow read: if isShortId(boardId);
        allow create: if isShortId(boardId)
          && isPost()
          && (isBoardAdmin(boardId) || (participantCanCreate(boardId) && request.resource.data.get('isStarred', false) == false));
        allow update: if isShortId(boardId)
          && (
            (isBoardAdmin(boardId) && isAdminPostEdit())
            || (participantCanEdit(boardId) && isOwnPostEdit() && request.resource.data.get('isStarred', false) == resource.data.get('isStarred', false))
            || (request.auth != null && boardParticipantMode(boardId) != "view" && resource.data.get('type', null) == "poll" && isPollVoteOnlyUpdate())
          );
        allow delete: if isShortId(boardId)
          && (isBoardAdmin(boardId) || (participantCanEdit(boardId) && isOwnPost()));
      }
    }

    match /classroomPostBoardAdmins/{boardId} {
      allow read: if false;
      allow create: if isShortId(boardId) && isPostBoardAdminMetadata();
      allow update: if isShortId(boardId)
        && isPostBoardAdminMetadata()
        && (
          resource.data.adminUid == request.auth.uid
          || resource.data.adminKey == request.resource.data.adminKey
        );
      allow delete: if false;
    }
  }
}
