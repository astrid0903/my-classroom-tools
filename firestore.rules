rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isShortId(value) {
      return value is string && value.size() > 0 && value.size() <= 120;
    }

    function isOptionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function isPostImageAt(images, index) {
      return images.size() <= index
        || (images[index] is string && images[index].size() <= 180000);
    }

    function isPostImages(value) {
      return value is list
        && value.size() <= 5
        && isPostImageAt(value, 0)
        && isPostImageAt(value, 1)
        && isPostImageAt(value, 2)
        && isPostImageAt(value, 3)
        && isPostImageAt(value, 4);
    }

    function isOptionalPostImages(value) {
      return value == null || isPostImages(value);
    }

    function isOptionalPostOrder(value) {
      return value == null || (value is number && value >= -9999999999999 && value <= 9999999999999);
    }

    function hasPostBody() {
      return (request.resource.data.content is string && request.resource.data.content.size() > 0)
        || (request.resource.data.imageDataUrl is string && request.resource.data.imageDataUrl.size() > 0)
        || (request.resource.data.imageDataUrls is list && request.resource.data.imageDataUrls.size() > 0);
    }

    function isPostBoardMetadata() {
      return request.auth != null
        && request.resource.data.keys().hasOnly(['title', 'adminUid', 'sections', 'note', 'bgColor', 'bgImage', 'bgOpacity', 'titleColor', 'updatedAt', 'kind', 'version'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.sections is list
        && request.resource.data.sections.size() <= 12
        && isOptionalString(request.resource.data.note, 5000)
        && isOptionalString(request.resource.data.bgColor, 40)
        && isOptionalString(request.resource.data.bgImage, 900000)
        && request.resource.data.bgOpacity is number
        && request.resource.data.bgOpacity >= 0
        && request.resource.data.bgOpacity <= 100
        && isOptionalString(request.resource.data.titleColor, 40)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.kind == 'postBoard'
        && request.resource.data.version == 1;
    }

    function isPost() {
      return request.resource.data.keys().hasOnly(['author', 'sectionId', 'content', 'imageDataUrl', 'imageDataUrls', 'order', 'createdAt', 'authorUid'])
        && isOptionalString(request.resource.data.author, 40)
        && request.resource.data.sectionId is string
        && request.resource.data.sectionId.size() > 0
        && request.resource.data.sectionId.size() <= 80
        && isOptionalString(request.resource.data.content, 600)
        && isOptionalString(request.resource.data.imageDataUrl, 950000)
        && isOptionalPostImages(request.resource.data.imageDataUrls)
        && isOptionalPostOrder(request.resource.data.order)
        && request.resource.data.createdAt == request.time
        && request.resource.data.authorUid == request.auth.uid
        && hasPostBody();
    }

    function isPostEdit() {
      return request.resource.data.keys().hasOnly(['author', 'sectionId', 'content', 'imageDataUrl', 'imageDataUrls', 'order', 'createdAt', 'updatedAt', 'authorUid'])
        && isOptionalString(request.resource.data.author, 40)
        && request.resource.data.sectionId is string
        && request.resource.data.sectionId.size() > 0
        && request.resource.data.sectionId.size() <= 80
        && isOptionalString(request.resource.data.content, 600)
        && isOptionalString(request.resource.data.imageDataUrl, 950000)
        && isOptionalPostImages(request.resource.data.imageDataUrls)
        && isOptionalPostOrder(request.resource.data.order)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.updatedAt == request.time
        && hasPostBody();
    }

    function isAdminPostEdit() {
      return request.auth != null
        && request.resource.data.keys().hasOnly(['author', 'sectionId', 'content', 'imageDataUrl', 'imageDataUrls', 'order', 'createdAt', 'updatedAt', 'authorUid'])
        && isOptionalString(request.resource.data.author, 40)
        && request.resource.data.sectionId is string
        && request.resource.data.sectionId.size() > 0
        && request.resource.data.sectionId.size() <= 80
        && isOptionalString(request.resource.data.content, 600)
        && isOptionalString(request.resource.data.imageDataUrl, 950000)
        && isOptionalPostImages(request.resource.data.imageDataUrls)
        && isOptionalPostOrder(request.resource.data.order)
        && request.resource.data.updatedAt == request.time
        && hasPostBody();
    }

    function isOwnPostEdit() {
      return request.auth != null
        && resource.data.authorUid == request.auth.uid
        && isPostEdit();
    }

    function isOwnPost() {
      return request.auth != null
        && resource.data.authorUid == request.auth.uid;
    }

    function isBoardAdmin(boardId) {
      return request.auth != null
        && get(/databases/$(database)/documents/classroomPostBoards/$(boardId)).data.adminUid == request.auth.uid;
    }

    match /classroomToolLayouts/{syncCode} {
      allow read: if isShortId(syncCode);
      allow write: if isShortId(syncCode)
        && request.resource.data.keys().hasOnly(['layouts', 'updatedAt', 'version'])
        && request.resource.data.layouts is map
        && request.resource.data.updatedAt == request.time
        && request.resource.data.version == 1;
    }

    match /classroomPostBoards/{boardId} {
      allow read: if isShortId(boardId);
      allow create: if isShortId(boardId) && isPostBoardMetadata();
      allow update: if isShortId(boardId)
        && isPostBoardMetadata()
        && (
          !resource.data.keys().hasAny(['adminUid'])
          || resource.data.adminUid == ""
          || resource.data.adminUid == request.auth.uid
        );
      allow delete: if false;

      match /posts/{postId} {
        allow read: if isShortId(boardId);
        allow create: if isShortId(boardId) && isPost();
        allow update: if isShortId(boardId)
          && (
            (isBoardAdmin(boardId) && isAdminPostEdit())
            || isOwnPostEdit()
          );
        allow delete: if isShortId(boardId)
          && (isBoardAdmin(boardId) || isOwnPost());
      }
    }
  }
}
